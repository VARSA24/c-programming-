Sum of factorials of its digits = the original number
Example:
145 = 1! + 4! + 5!

#include<stdio.h>

int strong(int n)
{
    int original = n, digit, sum = 0;
    while(n != 0)
    {
        digit = n % 10;
        int fact = 1;
        int i = 1;
        while(i <= digit)
        {
            fact = fact * i;
            i++;
        }
        sum = sum + fact;
        n = n / 10;
    }
    if(sum == original)
        return 1;
    else
        return 0;
}
int main()
{
    int n, result;
    scanf("%d", &n);
    result = strong(n);
    if(result == 1)
        printf("STRONG");
    else
        printf("NOT STRONG");
    return 0;
}
