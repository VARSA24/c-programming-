#include <stdio.h>
int main() {
    int a, b;
    scanf("%d %d", &a, &b);
    int sum = a + b;
    printf("Sum = %d", sum);
    return 0;
}



#include <stdio.h>
int main() {
    int a, b;
    scanf("%d %d", &a, &b);
    int sub = a - b;
    int pro = a * b;
    printf("Difference = %d\nProduct = %d", sub, pro);
    return 0;
}



#include <stdio.h>
int main() {
    int a, b;
    scanf("%d %d", &a, &b);
    int quo = a / b;
    int rem = a % b;
    printf("Quotient = %d\nRemainder = %d", quo, rem);
    return 0;
}
