#include<stdio.h>
int armstrong(int n)
{
    int original = n, digit, sum = 0;
    int count = 0, temp = n;
    while(temp != 0)
    {
        count++;
        temp = temp / 10;
    }
    while(n != 0)
    {
        digit = n % 10;
        int power = 1;
        int i = 1;
        while(i <= count)
        {
            power = power * digit;
            i++;
        }
        sum = sum + power;
        n = n / 10;
    }
    if(sum == original)
        return 1;
    else
        return 0;
}
int main()
{
    int n, result;
    scanf("%d", &n);
    result = armstrong(n);
    if(result == 1)
        printf("ARMSTRONG");
    else
        printf("NOT ARMSTRONG");
    return 0;
}
