#include<stdio.h>
int automorphic(int n)
{
    int sq = n * n;
    while(n != 0)
    {
        if(n % 10 != sq % 10)
            return 0;
        n = n / 10;
        sq = sq / 10;
    }
    return 1;
}
int main()
{
    int x, result;
    scanf("%d", &x);
    result = automorphic(x);
    if(result == 1)
        printf("AUTOMORPHIC");
    else
        printf("NOT AUTOMORPHIC");
    return 0;
}
