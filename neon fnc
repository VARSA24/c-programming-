A number is called Neon if
Sum of digits of its square = the number itself
9² = 81 → 8 + 1 = 9   ✔ Neon
1² = 1  → 1 = 1       ✔ Neon


#include<stdio.h>
int neon(int n)
{
    int sq, digit, sum = 0;
    sq = n * n;
    while(sq != 0)
    {
        digit = sq % 10;
        sum = sum + digit;
        sq = sq / 10;
    }
    if(sum == n)
        return 1;
    else
        return 0;
}
int main()
{
    int x, result;
    scanf("%d", &x);
    result = neon(x);
    if(result == 1)
        printf("NEON NUMBER");
    else
        printf("NOT A NEON NUMBER");
    return 0;
}
