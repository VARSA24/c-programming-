#include<stdio.h>
int prime(int a)
{
    int i = 2;
    if(a <= 1)
        return 0;
    while(i <= a / 2)
    {
        if(a % i == 0)
            return 0;   
        i++;
    }
    return 1;   
}
int main()
{
    int x, result;
    scanf("%d", &x);
    result = prime(x);
    if(result == 1)
        printf("PRIME");
    else
        printf("NOT PRIME");
    return 0;
}
