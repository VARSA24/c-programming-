#include<stdio.h>
int main()
{
    int n;
    int a = 0, b = 1, c;
    scanf("%d", &n);
    printf("%d %d ", a, b);
    for(int i = 3; i <= n; i++)
    {
        c = a + b;
        printf("%d ", c);
        a = b;
        b = c;
    }
    return 0;
}


Using while:
#include<stdio.h>
int main()
{
    int n;
    int a = 0, b = 1, c;
    int count = 2;
    scanf("%d", &n);
    printf("%d %d ", a, b);
    while(count < n)
    {
        c = a + b;
        printf("%d ", c);
        a = b;
        b = c;
        count++;
    }
    return 0;
}
