#include<stdio.h>
int main()
{
    int x, digit, original, sum = 0;
    scanf("%d", &x);
    original = x;
    while(x != 0)
    {
        digit = x % 10;
        sum = sum + (digit * digit * digit);
        x = x / 10;
    }
    if(original == sum)
    {
        printf("Armstrong");
    }
    else
    {
        printf("Not Armstrong");
    }
    return 0;
}
