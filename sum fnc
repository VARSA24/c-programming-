#include<stdio.h>
int sum(int a)
{
    int digit, result = 0;
    while(a != 0)
    {
        digit = a % 10;
        result = result + digit;
        a = a / 10;
    }
    return result;
}
int main()
{
    int x, result;
    scanf("%d", &x);
    result = sum(x);
    printf("Sum of digits is %d", result);
    return 0;
}
