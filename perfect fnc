#include<stdio.h>
int perfect(int n)
{
    int i = 1, sum = 0;
    while(i <= n / 2)
    {
        if(n % i == 0)
        {
            sum = sum + i;
        }
        i++;
    }
    if(sum == n)
        return 1;
    else
        return 0;
}
int main()
{
    int n, result;
    scanf("%d", &n);
    result = perfect(n);
    if(result == 1)
        printf("PERFECT");
    else
        printf("NOT PERFECT");
    return 0;
}
