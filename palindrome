#include<stdio.h>
int main()
{
    int x, digit, rev = 0;
    int original;
    scanf("%d", &x);
    original = x;
    while(x != 0)
    {
        digit = x % 10;
        rev = rev * 10 + digit;
        x = x / 10;
    }
    if(original == rev)
    {
        printf("Palindrome");
    }
    else
    {
        printf("Not a Palindrome");
    }
    return 0;
}
